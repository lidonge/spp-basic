domain physicalarray;
Entity Entry { String itemCode; String sector; }
Role Result { int observed; }
atomic query listEntries(Entry selection, Entry[] rows);
atomic calculate countEntries(Entry[] rows, Result result) { result.observed = rows.length; }
Scenario serial compareReads(Entry selection, Entry[] externalRows, Entry[] transactionalRows, Result before, Result inside) {
    listEntries(selection, externalRows);
    countEntries(externalRows, before);
    transaction {
        serial {
            listEntries(selection, transactionalRows);
            countEntries(transactionalRows, inside);
        }
    }
}
