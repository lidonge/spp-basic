domain ledger;

Role Funds {
    String wallet;
    quantum decimal amount;
}

Role ProviderPlayedRole {
    String accountCode;
    String currency;
    quantum decimal claim;
}

Contract TransferInput {
    decimal amount;
}

quantum update moveFunds(Funds consumerFunds, ProviderPlayedRole played, TransferInput transfer) {
    consumerFunds.amount -> played.claim : transfer.amount;
}

Scenario serial transferFunds(Funds consumerFunds, ProviderPlayedRole played, TransferInput transfer) {
    transaction {
        moveFunds bounds { played.claim: [null, 0]; };
    }
}

Scenario serial readClaim(ProviderPlayedRole played) {
    findProviderPlayedRole;
}

Scenario serial readClaimBy(ProviderPlayedRole played) {
    findProviderPlayedRole by ProviderPlayedRole.accountCode = "P-1",
        ProviderPlayedRole.currency = "UNIT";
}

Enum SettlementUnit { LOCAL_UNIT, UNLISTED }
Role SettlementPosition {
    String accountCode;
    SettlementUnit unit;
    quantum decimal claim;
}

quantum update settleFunds(Funds consumerFunds, SettlementPosition position, TransferInput transfer) {
    consumerFunds.amount -> position.claim : transfer.amount;
}

Scenario serial settlePosition(Funds consumerFunds, SettlementPosition position, TransferInput transfer) {
    transaction { settleFunds bounds { position.claim: [null, 0]; }; }
}

quantum update movePosition(ProviderPlayedRole origin, SettlementPosition destination, TransferInput transfer) {
    origin.claim -> destination.claim : transfer.amount;
}

Scenario serial transferPosition(ProviderPlayedRole origin, SettlementPosition destination, TransferInput transfer) {
    transaction { movePosition bounds { origin.claim: [0, null]; destination.claim: [null, 10]; }; }
}

Role LocalWallet;
take Funds as LocalWallet {
    takeall;
    quantum decimal amount;
}

quantum update moveWallet(LocalWallet origin, LocalWallet destination, TransferInput transfer) {
    origin.amount -> destination.amount : transfer.amount;
}

Scenario serial transferWallet(LocalWallet origin, LocalWallet destination, TransferInput transfer) {
    transaction { moveWallet(origin, destination, transfer) bounds { origin.amount: [0, null]; destination.amount: [null, 10]; }; }
}
