domain ledger;

Role Funds short consumerFunds {
    String wallet;
    String owner;
    quantum decimal amount;
}

Role ProviderPlayedRole short played {
    String accountCode;
    String currency;
    quantum decimal claim;
}

Contract TransferInput short transfer {
    decimal amount;
}

quantum update moveFunds(Funds, ProviderPlayedRole, TransferInput) {
    consumerFunds.amount -> played.claim : transfer.amount;
}

Scenario serial transferFunds(Funds, ProviderPlayedRole, TransferInput) {
    transaction {
        moveFunds bounds { played.claim: [null, 0]; };
    }
}

Scenario serial readClaim(ProviderPlayedRole) {
    findProviderPlayedRole;
}

Scenario serial readClaimBy(ProviderPlayedRole) {
    findProviderPlayedRole by played.accountCode = "P-1",
        played.currency = "UNIT";
}

Enum SettlementUnit { LOCAL_UNIT, UNLISTED }
Role SettlementPosition short position {
    String accountCode;
    SettlementUnit unit;
    quantum decimal claim;
}

quantum update settleFunds(Funds, SettlementPosition, TransferInput) {
    consumerFunds.amount -> position.claim : transfer.amount;
}

Scenario serial settlePosition(Funds, SettlementPosition, TransferInput) {
    transaction { settleFunds bounds { position.claim: [null, 0]; }; }
}

quantum update movePosition(ProviderPlayedRole, SettlementPosition, TransferInput) {
    played.claim -> position.claim : transfer.amount;
}

Scenario serial transferPosition(ProviderPlayedRole, SettlementPosition, TransferInput) {
    transaction { movePosition bounds { played.claim: [0, null]; position.claim: [null, 10]; }; }
}

Role LocalWallet;
take Funds as LocalWallet {
    takeall;
    quantum decimal amount;
}

Role OriginWallet short origin;
Role DestinationWallet short destination;

quantum update moveWallet(OriginWallet, DestinationWallet, TransferInput) {
    origin.amount -> destination.amount : transfer.amount;
}

Scenario serial transferWallet(OriginWallet, DestinationWallet, TransferInput) {
    transaction { moveWallet(origin, destination, transfer) bounds { origin.amount: [0, null]; destination.amount: [null, 10]; }; }
}

readonly Scenario serial readWalletRoles(OriginWallet, DestinationWallet) {
    findOriginWallet;
    findDestinationWallet;
}
