domain ledger;

phy {
    environment develop {
        repository records {
            adapter jdbcObjectRepository;
            config default = true;
            config appDdlTables = true;
            config datasourceUrl = "${spp.basic-ledger.datasource-url:jdbc:h2:mem:basic_ledger;DB_CLOSE_DELAY=-1}";
            config driverClassName = "org.h2.Driver";
            config table = "ledger_records";
        }
        backend ledgerDatabase {
            adapter localJdbc;
            at ledgerResource;
            repository records;
            config datasourceUrl = "${spp.basic-ledger.datasource-url:jdbc:h2:mem:basic_ledger;DB_CLOSE_DELAY=-1}";
            config driverClassName = "org.h2.Driver";
        }
    }
    technical service callCounter {
        implementation: "example.technical.CallCounter";
    }
}
