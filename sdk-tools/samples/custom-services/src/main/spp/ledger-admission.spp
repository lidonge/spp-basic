domain ledger;

Enum ProviderOutcome { NOT_FOUND:"E1214","OLD", SUCCESS:"", UNRECOGNIZED:other }
Role ProviderResult { String(28) accountNumber; ProviderOutcome code; }

atomic check checkProvider(ProviderResult result) {
    require(result.code == ProviderOutcome.SUCCESS, result.code);
}

Scenario serial verifyAdmission(ProviderResult result) {
    findProviderResult;
    identify(result);
    checkProvider(result);
}

Enum AccountCode { FIRST:"A1", UNLISTED:other }
Enum StrictOutcome { NOT_FOUND:"E1214", OTHER:"OTHER" }
Role AdmissionLookup { AccountCode keyCode; StrictOutcome code; }
Scenario serial readAdmission(AdmissionLookup lookup) {
    findAdmissionLookup;
    identify(lookup);
}

Reference Admission from positions.Admission {
    String(28) account;
    String(5) returnCode;
}
Role StoredResult { String receipt; String accountNumber; ProviderOutcome code; }

Role AdmissionText { String accountNumber; String text; }
atomic check checkAdmissionText(AdmissionText result) {
    require(result.text == BLANK, "TEXT_PRESENT");
    require(result.text == "   ", "ORIGINAL_TEXT_CHANGED");
}
Scenario serial verifyAdmissionText(AdmissionText result) {
    findAdmissionText;
    identify(result);
    checkAdmissionText(result);
}

Scenario serial verifyBlankAccount(AdmissionText result) {
    findAdmissionText by AdmissionText.accountNumber = BLANK;
    identify(result);
    checkAdmissionText(result);
}

Role CodedAdmission { String accountNumber; ProviderOutcome code; }
atomic check checkBlankAdmission(CodedAdmission result) {
    require(result.accountNumber == BLANK, "ACCOUNT_PRESENT");
    require(result.code == ProviderOutcome.NOT_FOUND, "WRONG_CODE");
}
Scenario serial readBlankAdmission(CodedAdmission result) {
    findCodedAdmission by CodedAdmission.accountNumber = BLANK;
    identify(result);
    checkBlankAdmission(result);
}

Role AdmissionTicket { String receipt; String(4) batch; String note; }
Enum AdmissionError { DUPLICATE:"A02" }
atomic check checkTicket(AdmissionTicket ticket) {
    require(ticket.note == BLANK, "NOTE_PRESENT");
}
Scenario serial readUniqueAdmission(CodedAdmission result, AdmissionTicket ticket) {
    unique findCodedAdmission by CodedAdmission.accountNumber = BLANK;
    identify(result);
    checkBlankAdmission(result);
    transaction {
        unique findAdmissionTicket by AdmissionTicket.batch = BLANK else AdmissionError.DUPLICATE;
        checkTicket(ticket),breakTransaction;
    }
}
