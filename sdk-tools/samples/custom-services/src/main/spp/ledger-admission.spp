domain ledger;

Enum RejectionCode {
    ACCOUNT_PRESENT,
    NOTE_PRESENT,
    ORIGINAL_TEXT_CHANGED,
    TEXT_PRESENT,
    WRONG_CODE
}

Enum ProviderOutcome { NOT_FOUND:"E1214","OLD", SUCCESS:"", UNRECOGNIZED:other }
Role ProviderResult short result { String(28) accountNumber; ProviderOutcome code; }

atomic check checkProvider(ProviderResult) {
    require(result.code == ProviderOutcome.SUCCESS, result.code);
}

Scenario serial verifyAdmission(ProviderResult) {
    findProviderResult;
    identify(result);
    checkProvider(result);
}

Enum AccountCode { FIRST:"A1", UNLISTED:other }
Enum StrictOutcome { NOT_FOUND:"E1214", OTHER:"OTHER" }
Role AdmissionLookup short lookup { AccountCode keyCode; StrictOutcome code; }
Scenario serial readAdmission(AdmissionLookup) {
    findAdmissionLookup;
    identify(lookup);
}

Reference Admission from positions.Admission {
    String(28) account;
    String(5) returnCode;
}
Role StoredResult { String receipt; String accountNumber; ProviderOutcome code; }

Role AdmissionText short result { String accountNumber; String text; }
atomic check checkAdmissionText(AdmissionText) {
    require(result.text == BLANK, RejectionCode.TEXT_PRESENT);
    require(result.text == "   ", RejectionCode.ORIGINAL_TEXT_CHANGED);
}
Scenario serial verifyAdmissionText(AdmissionText) {
    findAdmissionText;
    identify(result);
    checkAdmissionText(result);
}

Scenario serial verifyBlankAccount(AdmissionText) {
    findAdmissionText by result.accountNumber = BLANK;
    identify(result);
    checkAdmissionText(result);
}

Role CodedAdmission short result { String accountNumber; ProviderOutcome code; }
atomic check checkBlankAdmission(CodedAdmission) {
    require(result.accountNumber == BLANK, RejectionCode.ACCOUNT_PRESENT);
    require(result.code == ProviderOutcome.NOT_FOUND, RejectionCode.WRONG_CODE);
}
Scenario serial readBlankAdmission(CodedAdmission) {
    findCodedAdmission by result.accountNumber = BLANK;
    identify(result);
    checkBlankAdmission(result);
}

Role AdmissionTicket short ticket { String receipt; String(4) batch; String note; }
Enum AdmissionError { DUPLICATE:"A02" }
atomic check checkTicket(AdmissionTicket) {
    require(ticket.note == BLANK, RejectionCode.NOTE_PRESENT);
}
Scenario serial readUniqueAdmission(CodedAdmission, AdmissionTicket) {
    unique findCodedAdmission by result.accountNumber = BLANK;
    identify(result);
    checkBlankAdmission(result);
    transaction {
        unique findAdmissionTicket by ticket.batch = BLANK else AdmissionError.DUPLICATE;
        checkTicket(ticket),breakTransaction;
    }
}
