domain positions;

phy {
    environment develop {
        repository records {
            adapter jdbcObjectRepository;
            config default = true;
            config appDdlTables = true;
            config datasourceUrl = "${spp.basic-ledger.datasource-url:jdbc:h2:mem:basic_ledger;DB_CLOSE_DELAY=-1}";
            config driverClassName = "org.h2.Driver";
            config table = "ledger_records";
        }
        backend ledgerDatabase {
            adapter localJdbc;
            repository records;
            quantumStore providerPositions;
            config datasourceUrl = "${spp.basic-ledger.datasource-url:jdbc:h2:mem:basic_ledger;DB_CLOSE_DELAY=-1}";
            config driverClassName = "org.h2.Driver";
        }
        quantumStore providerPositions {
            adapter jdbcQuantum;
            config datasourceUrl = "${spp.basic-ledger.datasource-url:jdbc:h2:mem:basic_ledger;DB_CLOSE_DELAY=-1}";
            config driverClassName = "org.h2.Driver";
            config journalStore = "com.servpp.service.transaction.JdbcQuantumJournalStore";
            config journalTable = "transfer_journal";
            config valueTable = "transfer_values";
        }
    }
}
