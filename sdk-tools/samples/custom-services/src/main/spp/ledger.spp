domain ledger;

Role Facts {
    int amount;
}

Entity Entry {
    String code;
    String note;
    int amount;
}

Contract Revision {
    String note;
    int amount;
}

atomic calculate twice(Facts) {
    Facts.amount *= 2;
}

readonly Scenario serial preview(Facts) {
    twice;
}

atomic calculate applyRevision(Entry, Revision) {
    Entry.note = Revision.note;
    Entry.amount = Revision.amount;
}

Scenario serial createRecord(Entry, Revision) {
    applyRevision;
    transaction {
        insertEntry;
    }
}

Scenario serial readRecord(Entry) {
    findEntry;
}

atomic calculate projectAmount(Entry, Facts) {
    Facts.amount = Entry.amount * 2;
}

readonly Scenario serial previewRecord(Entry, Facts) {
    findEntry;
    identify(Entry);
    projectAmount;
}

Scenario serial reviseRecord(Entry, Revision) {
    findEntry;
    applyRevision;
    transaction {
        updateEntry;
    }
}

Role Lookup {
    String entryCode;
}

take Lookup as Entry {
    String code = entryCode;
}

readonly Scenario serial readSelectedRecord(Entry, Lookup) {
    findEntry by Lookup;
}
