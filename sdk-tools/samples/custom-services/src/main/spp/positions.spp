domain positions;

Entity Position {
    String account;
    String currency;
    quantum decimal outstanding;
}

atomic query readPosition(Position);

Reference ProviderPlayedRole from ledger.ProviderPlayedRole {
    String accountCode;
    String currency;
    quantum decimal claim;
}

take Position as ProviderPlayedRole {
    String accountCode = account;
    decimal claim = outstanding;
    mapsame;
}
