domain provider;
Entity CustodyHandover { String receiptNumber; quantum decimal cash; }
Entity CustodyTill { String receiptNumber; quantum decimal cash; }

atomic update insertCustodyHandover(CustodyHandover);

atomic update insertCustodyTill(CustodyTill);
Contract TillOpening { String receiptNumber; }
atomic calculate identifyOpening(TillOpening, CustodyTill) { CustodyTill.receiptNumber = TillOpening.receiptNumber; }
Scenario serial openTill(TillOpening, CustodyTill) {
    identifyOpening;
    transaction { insertCustodyTill; }
}
