domain client;
Role Handover { String receiptNumber; quantum decimal cash; }
Reference Intake from provider.CustodyHandover { String receiptNumber; quantum decimal cash; }
atomic update insertIntake(Intake);
atomic calculate prepareIntake(Receipt, Intake) { Intake.receiptNumber = Receipt.receiptNumber; }
Role Till { String receiptNumber; quantum decimal cash; }
Contract Receipt { String receiptNumber; decimal amount; decimal funding; }
take Receipt as Handover { mapsame; }
take Receipt as Till { mapsame; }
atomic calculate prepare(Receipt, Handover) {
    Handover.receiptNumber = Receipt.receiptNumber;
}
quantum update receive(Receipt, Handover, Till) { Handover.cash -> Till.cash : Receipt.amount; }
Scenario serial confirm(Receipt, Handover, Till, Intake, Accepted) {
    findTill by Receipt;
    identify(Till);
    prepareIntake;
    stageAccepted;
    transaction {
        serial {
            insertIntake;
            findHandover by Receipt;
            identify(Handover);
            receive bounds { Handover.cash: [0, 0]; Till.cash: [0, null]; };
            insertAccepted;
        }
    }
}
Entity Accepted { String receiptNumber; quantum decimal funds; }
atomic update insertAccepted(Accepted);
atomic calculate stageAccepted(Receipt, Accepted) { Accepted.receiptNumber = Receipt.receiptNumber; }

atomic calculate chooseMissingReceipt(Receipt) { Receipt.receiptNumber = "MISSING"; }
Scenario serial confirmAbsent(Receipt, Handover, Till, Intake, Accepted) {
    findTill by Receipt;
    identify(Till);
    prepareIntake;
    stageAccepted;
    transaction {
        insertIntake;
        chooseMissingReceipt;
        prepare;
        receive;
        insertAccepted;
    }
}
Scenario serial confirmSkipped(Receipt, Handover, Till, Intake, Accepted) {
    findTill by Receipt;
    identify(Till);
    prepareIntake;
    stageAccepted;
    transaction {
        insertIntake;
        chooseMissingReceipt;
        findHandover by Receipt;
        identify(Handover);
        receive;
        insertAccepted;
    }
}

quantum update skipReceive(Receipt, Handover, Till) {
    if (Receipt.amount < 0) { Handover.cash -> Till.cash : Receipt.amount; }
}
Scenario serial confirmNoMovement(Receipt, Handover, Till, Intake, Accepted) {
    findTill by Receipt;
    identify(Till);
    prepareIntake;
    prepare;
    stageAccepted;
    transaction {
        insertIntake;
        skipReceive;
        insertAccepted;
    }
}
