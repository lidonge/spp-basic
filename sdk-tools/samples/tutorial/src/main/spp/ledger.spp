domain ledger;

Enum RejectionCode {
    THE_AMOUNT_MUST_BE_14:"The amount must be 14"
}

Role Facts {
    int amount;
}

atomic calculate prepare(Facts) {
    Facts.amount = 7;
}

atomic calculate twice(Facts) {
    Facts.amount *= 2;
}

atomic check verifyAmount(Facts) {
    require(Facts.amount == 14, RejectionCode.THE_AMOUNT_MUST_BE_14);
}

Scenario serial preview(Facts) {
    prepare;
    twice;
    verifyAmount;
}
