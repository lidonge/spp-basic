#!/usr/bin/env python3
"""Stage type-only S++ parameter edits using the Basic SDK parser."""
import argparse
import difflib
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import tempfile

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("root", type=Path)
parser.add_argument("--apply", action="store_true", help="Install edits after a successful staged build")
parser.add_argument("--verify", help="Build command run from a temporary copy of ROOT")
parser.add_argument("--conflicts", type=Path, help="Write the conflict list to this file")
parser.add_argument("--manifest", type=Path, help="Only inspect these newline-separated paths relative to ROOT")
parser.add_argument("--summary", action="store_true", help="Omit the unified diff")
parser.add_argument("--use-declared-names", action="store_true",
                    help="Resolve differing old aliases using the declared short name or the default")
args = parser.parse_args()
if args.apply and not args.verify:
    parser.error("--apply requires --verify")

root = args.root.resolve(strict=True)
if not root.is_dir():
    parser.error("ROOT must be a directory")
sdk = Path(__file__).resolve().parent.parent
repo = next((opt.partition("=")[2] for opt in shlex.split(os.environ.get("MAVEN_OPTS", ""))
             if opt.startswith("-Dmaven.repo.local=")), str(Path.home() / ".m2/repository"))
lang = sdk / "lang/target/classes"
compiler = sdk / "sdk-tools/compiler/target/classes"
if not (compiler / "com/servpp/sdk/compiler/ParticipantMigration.class").is_file():
    parser.error("Build the SDK first with mvn -pl sdk-tools/compiler -am -DskipTests package")
runtime = Path(repo) / "org/antlr/antlr4-runtime/4.13.2/antlr4-runtime-4.13.2.jar"
if not runtime.is_file():
    parser.error(f"ANTLR runtime is missing at {runtime}")

skip = {".git", "target", "node_modules"}
if args.manifest:
    paths = [Path(line) for line in args.manifest.read_text().splitlines() if line.strip()]
else:
    paths = [path.relative_to(root) for directory, subdirs, files in os.walk(root)
             for _ in [subdirs.__setitem__(slice(None), sorted(set(subdirs) - skip))]
             for name in files if (path := Path(directory) / name).suffix == ".spp"]
paths = sorted(set(paths))
for path in paths:
    if path.is_absolute() or path.suffix != ".spp" or ".." in path.parts or (root / path).resolve() != root / path:
        parser.error(f"Invalid source path: {path}")

with tempfile.TemporaryDirectory(prefix="spp-participants-") as temporary:
    workspace = Path(temporary)
    manifest = workspace / "sources"
    edits = workspace / "edits"
    edits.mkdir()
    manifest.write_text("".join(f"{path}\n" for path in paths))
    subprocess.run(["java", "-cp", os.pathsep.join(map(str, [compiler, lang, runtime])),
                    "com.servpp.sdk.compiler.ParticipantMigration",
                    str(root), str(manifest), str(edits), str(args.use_declared_names).lower()], check=True)
    conflicts = (edits / ".conflicts").read_text()
    if args.conflicts:
        args.conflicts.write_text(conflicts.replace(f"{root}/", ""))
    elif conflicts:
        print(conflicts, end="")
    changed = sorted(path for path in paths if (edits / path).is_file())
    originals = {path: (root / path).read_bytes() for path in changed}
    if not args.summary:
        for path in changed:
            previous = originals[path].decode().splitlines(keepends=True)
            proposed = (edits / path).read_bytes().decode().splitlines(keepends=True)
            print("".join(difflib.unified_diff(previous, proposed, f"a/{path}", f"b/{path}")), end="")
    if args.verify and not conflicts:
        staged = workspace / "project"
        shutil.copytree(root, staged, ignore=shutil.ignore_patterns(*skip), symlinks=True)
        for path in changed:
            shutil.copyfile(edits / path, staged / path)
        subprocess.run(shlex.split(args.verify), cwd=staged, check=True)
    if args.apply and not conflicts:
        if any((root / path).read_bytes() != originals[path] for path in changed):
            parser.error("A source changed during verification. Run migration again.")
        for path in changed:
            source = root / path
            with tempfile.NamedTemporaryFile(dir=source.parent, delete=False) as replacement:
                replacement.write((edits / path).read_bytes())
            try:
                shutil.copymode(source, replacement.name)
                os.replace(replacement.name, source)
            finally:
                Path(replacement.name).unlink(missing_ok=True)
    if conflicts:
        raise SystemExit(2)
