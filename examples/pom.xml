<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.servpp.examples</groupId>
  <artifactId>spp-examples</artifactId>
  <version>1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>S++ Public Demos</name>
  <description>Independent source-language demonstrations using the separately supplied S++ compiler and runtime.</description>
  <modules>
    <module>demos/petstore</module>
    <module>demos/bank-deposit</module>
  </modules>
  <properties>
    <maven.compiler.source>17</maven.compiler.source>
    <maven.compiler.target>17</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spp.sdk.version>1.0-SNAPSHOT</spp.sdk.version>
    <jackson.version>2.18.3</jackson.version>
    <spp.examples.enhanced>false</spp.examples.enhanced>
  </properties>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>
  </dependencies>
  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
          <configuration>
            <systemPropertyVariables>
              <spp.examples.enhanced>${spp.examples.enhanced}</spp.examples.enhanced>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
  <profiles>
    <profile>
      <id>enhanced</id>
      <properties><spp.examples.enhanced>true</spp.examples.enhanced></properties>
      <dependencies>
        <dependency><groupId>com.servpp</groupId><artifactId>generator-enhanced</artifactId><version>${spp.sdk.version}</version></dependency>
        <dependency><groupId>com.servpp</groupId><artifactId>appframe-enhanced</artifactId><version>${spp.sdk.version}</version></dependency>
      </dependencies>
      <build>
        <pluginManagement>
          <plugins>
            <plugin>
              <groupId>com.servpp</groupId><artifactId>generator</artifactId><version>${spp.sdk.version}</version>
              <dependencies><dependency><groupId>com.servpp</groupId><artifactId>generator-enhanced</artifactId><version>${spp.sdk.version}</version></dependency></dependencies>
            </plugin>
          </plugins>
        </pluginManagement>
      </build>
    </profile>
  </profiles>
</project>
