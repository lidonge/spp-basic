domain cboddeposit;

// Zero date encodes absent agreement dates; clipping is business policy, not APP routing.

Role AgreementTerm {
    int effectiveDate;
    int cancelDate;
}

// The clipped window and the overlap period are second participants of the BankDate and
// InterestPeriod types, so each is a distinct role over its base type.
Role OverlapStart short clippedStart;
take BankDate as OverlapStart;

Role OverlapEnd short clippedEnd;
take BankDate as OverlapEnd;

Role OverlapPeriod short overlap;
take InterestPeriod as OverlapPeriod;

atomic calculate prepareAgreementWindow(
    BankDate,
    PeriodEnd,
    AgreementTerm,
    OverlapStart,
    OverlapEnd,
    InterestPeriod,
    OverlapPeriod,
    AgreementPolicy
) {
    clippedStart.encoded = start.encoded;
    clippedEnd.encoded = start.encoded;
    overlap.amount = normal.amount;
    overlap.unit = normal.unit;
    overlap.days = 0;
    agreementPolicy.enabled = agreementPolicy.enabled && agreementTerm.effectiveDate > 0;
    if (agreementPolicy.enabled) {
        clippedStart.encoded = max(start.encoded, agreementTerm.effectiveDate);
        clippedEnd.encoded = end.encoded;
        if (agreementTerm.cancelDate > 0) {
            clippedEnd.encoded = min(end.encoded, agreementTerm.cancelDate);
        }
        if (clippedStart.encoded >= clippedEnd.encoded) {
            agreementPolicy.enabled = false;
            clippedStart.encoded = start.encoded;
            clippedEnd.encoded = start.encoded;
        }
    }
}
