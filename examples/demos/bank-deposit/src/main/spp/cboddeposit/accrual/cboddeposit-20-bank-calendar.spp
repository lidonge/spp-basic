domain cboddeposit;

// Business interest-unit quantization, CSAPRD2 5300; dates supplied by shared calendar service.

Role InterestPeriod short normal {
    BigDecimal(19, 2) amount;
    BigDecimal(19, 2) unit;
    int days;
}

Role InterestProduct {
    BigDecimal(19, 2) qualifiedAmount;
    BigDecimal(19, 2) product;
}

atomic check checkInterestPeriod(InterestPeriod) {
    require(
        normal.amount >= 0 && normal.unit > 0 && normal.days >= 0,
        RejectionCode.INVALID_INTEREST_PERIOD
    );
}

atomic check checkBankDate(BankDate) {
    require(start.encoded != null && start.encoded != 0, RejectionCode.EEC28);
    require(start.encoded >= 10000101 && start.encoded <= 99991231, RejectionCode.EE374);
    require(isGregorianDate(start.encoded), RejectionCode.EE374);
}

atomic check checkBankDays(BankDate, PeriodEnd, InterestCalendar) {
    require(start.epochDay <= end.epochDay, RejectionCode.E1175);
    require(
        interestCalendar.convention == "ACT"
            || interestCalendar.convention == "360365"
            || interestCalendar.convention == "360360",
        RejectionCode.EEC28
    );
}

atomic calculate calculateInterestProduct(InterestPeriod, InterestProduct) {
    interestProduct.qualifiedAmount = roundDown(
        normal.amount / normal.unit,
        0
    ) * normal.unit;
    interestProduct.product = interestProduct.qualifiedAmount * normal.days;
}

// CSAPRD2/CCMDAT1 function O: start included, end excluded.
// The shared Gregorian functions decode representation; business selects ACT or deposit 360-day policy.

Role BankDate short start {
    int encoded;
    int year;
    int month;
    int day;
    int epochDay;
}

// The end of a period is a distinct participant from its start, so it is a role over BankDate.
Role PeriodEnd short end;
take BankDate as PeriodEnd;

Role InterestCalendar {
    String convention;
}

atomic calculate decodeBankDate(BankDate) {
    start.year = dateYear(start.encoded);
    start.month = dateMonth(start.encoded);
    start.day = dateDay(start.encoded);
    start.epochDay = dateEpochDay(start.encoded);
}

atomic calculate calculateBankDays(BankDate, PeriodEnd, InterestCalendar, InterestPeriod) {
    if (interestCalendar.convention == "ACT") {
        normal.days = end.epochDay - start.epochDay;
    } else {
        normal.days = 360
            * (end.year
            - start.year)
            + 30
            * (end.month
            - start.month)
            + min(end.day, 30)
            - min(start.day, 30);
    }
}
