domain cboddeposit;

Scenario serial previewInterestProduct(
    BankDate,
    PeriodEnd,
    InterestCalendar,
    InterestPeriod,
    InterestProduct
) {
    checkBankDate(start);
    checkBankDate(end);
    decodeBankDate(start);
    decodeBankDate(end);
    checkBankDays(start, end, interestCalendar);
    calculateBankDays(start, end, interestCalendar, normal);
    checkInterestPeriod;
    calculateInterestProduct;
}
