domain cboddeposit;

Enum RejectionCode {
    ACCOUNT_PARTICIPANTS_MISMATCH,
    DEPOSIT_ACCOUNTING_NOT_BALANCED,
    DEPOSIT_ACCOUNTING_TOTAL_MISMATCH,
    DEPOSIT_ALREADY_REVERSED,
    DEPOSIT_AREA_NOT_FOUND,
    DEPOSIT_FEE_RATE_NOT_FOUND,
    DEPOSIT_FEE_TARIFF_MISMATCH,
    DEPOSIT_OPERATOR_CONTEXT_MISMATCH,
    DEPOSIT_POSTINGS_NOT_BALANCED,
    DEPOSIT_SUBBRANCH_RELATION_NOT_FOUND,
    E1043,
    E1044,
    E1095,
    E1155,
    E1175,
    EDF19,
    EE374,
    EEC28,
    EG877,
    EI090,
    EN097,
    EN111,
    EN113,
    EN134,
    EN173,
    EN174,
    EN175,
    EN177,
    EN249,
    EN432,
    EN470,
    EO082,
    EP192,
    ES020,
    INTERNAL_ACCOUNTS_MUST_DIFFER,
    INTERNAL_ACCOUNT_NUMBER_REQUIRED,
    INVALID_ACCRUAL_UNIT,
    INVALID_AGREEMENT_BANDS,
    INVALID_AGREEMENT_PERIOD,
    INVALID_CASH_REVERSAL_FACTS,
    INVALID_DEPOSIT_FEE_RATE,
    INVALID_DEPOSIT_POSTING_RULES,
    INVALID_DEPOSIT_POSTING_SIDE,
    INVALID_DEPOSIT_RANGE,
    INVALID_DETAIL_COUNT,
    INVALID_INTEREST_PERIOD,
    INVALID_ORIGINAL_DEPOSIT_FEE,
    INVALID_ORIGINAL_DEPOSIT_MOVEMENT,
    INVALID_ORIGINAL_DEPOSIT_POSTINGS,
    NEGATIVE_DEPOSIT_ACCOUNTING_AMOUNT,
    ORIGINAL_DEPOSIT_ACCOUNT_MISMATCH,
    ORIGINAL_DEPOSIT_LEDGER_EVIDENCE_MISMATCH,
    ORIGINAL_DEPOSIT_MOVEMENT_NOT_BALANCED,
    ORIGINAL_DEPOSIT_POSTING_AMOUNT_MISMATCH,
    ORIGINAL_DEPOSIT_POSTING_OWNER_MISMATCH,
    ORIGINAL_SETTLEMENT_ACCOUNTS_MISMATCH,
    PENDING_AUTHORIZATION,
    UNSUPPORTED_CASH_REVERSAL_PATH,
    UNSUPPORTED_DEPOSIT_FEE_ACCOUNT,
    UNSUPPORTED_DEPOSIT_OPERATOR_PATH,
