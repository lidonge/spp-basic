domain cboddeposit;

atomic calculate configureAdmissionRuleCase39(context AdmissionRuleExampleFacts example) {
    example.request.amount = 1500; example.request.currency = "USD"; example.channel.transactionFamily = "XT01821";
    example.expectedCode = "";
}
atomic check verifyAdmissionRuleCase39(AdmissionRuleExampleFacts example) {
    require(example.decision.requiredLevel == "None", "EXAMPLE_ADMISSION_RULE_39_1");
    require(example.decision.authorizationCode == "", "EXAMPLE_ADMISSION_RULE_39_2");
}
