    serial { transaction quantum { seedCashExampleTariff(example.record); } }
    prepareDepositFee(example.request, example.party, example.channel, example.rate, example.plan);
    verifyFeeRuleExample(example);
    initializeFeeRuleExample(example);
    configureFeeRuleCase11(example);
