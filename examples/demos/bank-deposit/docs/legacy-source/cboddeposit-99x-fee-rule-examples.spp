    initializeFeeRuleExample(example);
    configureFeeRuleCase15(example);
    try { calculateDepositFee(example.request, example.rate, example.plan); }
    catch (CashFailureFacts example.failure) {}
    verifyFeeRuleFailureExample(example);
    verifyFeeTariffMismatchUnchangedExample(example);
    initializeFeeRuleExample(example);
    configureFeeRuleCase16(example);
    try { prepareDepositFee(example.request, example.party, example.channel, example.rate, example.plan); }
    catch (CashFailureFacts example.failure) {}
    verifyFeeRuleFailureExample(example);
