domain cboddeposit;

atomic calculate configureBankQualificationCase45(context BankQualificationExampleFacts example) {
    example.profile.accountSeries = "49927"; example.profile.cardLinked = true; example.profile.cardRecordFound = true; example.profile.cardLoss = "Oral"; example.profile.passbookLoss = "Written";
    example.expectedCode = "";
}
atomic check verifyBankQualificationCase45(BankQualificationExampleFacts example) {
    require(example.notices.cardWarning == "WN200" && example.notices.passbookWarning == "WN201", "EXAMPLE_BANK_NOTICES_45");
}
