atomic calculate configureFinancialInverseCase06(context FinancialInverseExampleFacts example) {
    example.request.amount = .01;
    example.before.interestBase = 0;
    example.before.overdraftPrincipal = .01;
    example.before.overdraftInterest = .005;
    example.before.collectionInterest = .004;
    example.before.overdraftExposure = .01;
    example.before.loanState = "Normal";
    example.current.interestBase = 0;
    example.current.overdraftPrincipal = .009;
    example.current.overdraftInterest = 0;
    example.current.collectionInterest = 0;
    example.current.overdraftExposure = .009;
    example.current.loanState = "Normal";
    example.snapshot = copy(example.current); example.capacity.overdraftPermitted = true; example.capacity.overdraftLimit = 1;
    example.expectedCode = "";
    example.expected.interestBase = 0;
    example.expected.overdraftInterest = .005;
    example.expected.collectionInterest = .004;
    example.expected.overdraftPrincipal = .01;
    example.expected.overdraftExposure = .01;
    example.expected.availableBalance = 0;
    example.expected.accountBalance = -.019;
}
