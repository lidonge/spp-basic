domain cboddeposit;

atomic calculate configureFinancialInverseCase01(context FinancialInverseExampleFacts example) {
    example.request.amount = 10;
    example.before.interestBase = 200;
    example.before.overdraftPrincipal = 0;
    example.before.overdraftInterest = 0;
    example.before.collectionInterest = 0;
    example.before.overdraftExposure = 0;
    example.before.loanState = "Normal";
    example.current.interestBase = 110;
    example.current.overdraftPrincipal = 0;
    example.current.overdraftInterest = 0;
    example.current.collectionInterest = 0;
    example.current.overdraftExposure = 0;
    example.current.loanState = "Normal";
    example.snapshot = copy(example.current); example.capacity.overdraftPermitted = false; example.capacity.overdraftLimit = 0;
    example.expectedCode = "";
    example.expected.interestBase = 100;
    example.expected.overdraftInterest = 0;
    example.expected.collectionInterest = 0;
    example.expected.overdraftPrincipal = 0;
    example.expected.overdraftExposure = 0;
    example.expected.availableBalance = 100;
    example.expected.accountBalance = 100;
}
atomic calculate configureFinancialInverseCase02(context FinancialInverseExampleFacts example) {
    example.request.amount = 10;
    example.before.interestBase = 200;
    example.before.overdraftPrincipal = 0;
    example.before.overdraftInterest = 0;
    example.before.collectionInterest = 0;
    example.before.overdraftExposure = 0;
    example.before.loanState = "Normal";
    example.current.interestBase = 230;
    example.current.overdraftPrincipal = 0;
    example.current.overdraftInterest = 0;
    example.current.collectionInterest = 0;
    example.current.overdraftExposure = 0;
    example.current.loanState = "Normal";
    example.current.frozenAmount = 50; example.current.authorizedAmount = 20;
    example.snapshot = copy(example.current); example.capacity.overdraftPermitted = false; example.capacity.overdraftLimit = 0;
    example.expectedCode = "";
    example.expected.interestBase = 220;
    example.expected.overdraftInterest = 0;
    example.expected.collectionInterest = 0;
    example.expected.overdraftPrincipal = 0;
    example.expected.overdraftExposure = 0;
    example.expected.availableBalance = 150;
    example.expected.accountBalance = 220;
}
atomic calculate configureFinancialInverseCase03(context FinancialInverseExampleFacts example) {
    example.request.amount = 50;
    example.before.interestBase = 0;
    example.before.overdraftPrincipal = 100;
    example.before.overdraftInterest = 30;
    example.before.collectionInterest = 40;
    example.before.overdraftExposure = 100;
    example.before.loanState = "Normal";
    example.current.interestBase = 0;
    example.current.overdraftPrincipal = 80;
    example.current.overdraftInterest = 0;
    example.current.collectionInterest = 10;
    example.current.overdraftExposure = 80;
    example.current.loanState = "BadDebt";
    example.snapshot = copy(example.current); example.capacity.overdraftPermitted = true; example.capacity.overdraftLimit = 100;
    example.expectedCode = "";
    example.expected.interestBase = 0;
    example.expected.overdraftInterest = 30;
    example.expected.collectionInterest = 30;
    example.expected.overdraftPrincipal = 80;
    example.expected.overdraftExposure = 80;
    example.expected.availableBalance = 0;
    example.expected.accountBalance = -140;
}
