domain cboddeposit;

atomic calculate configureFeeRuleCase01(context FeeRuleExampleFacts example) {
    example.party.customerId = "SOURCE-FEE-RULE-01"; example.record.customerId = example.party.customerId;
    example.channel.branchId = "001001001";
    example.expectedCode = "";
    example.expected.fee = 0; example.expected.variableAmount = 0; example.expected.range = 0; example.expected.tariff = ""; example.expected.applicable = false;
}
atomic calculate configureFeeRuleCase02(context FeeRuleExampleFacts example) {
    example.party.customerId = "SOURCE-FEE-RULE-02"; example.record.customerId = example.party.customerId;

    example.expectedCode = "";
    example.expected.fee = 6; example.expected.variableAmount = 5; example.expected.range = 1; example.expected.tariff = "SAC00001"; example.expected.applicable = true;
}
atomic calculate configureFeeRuleCase03(context FeeRuleExampleFacts example) {
    example.party.customerId = "SOURCE-FEE-RULE-03"; example.record.customerId = example.party.customerId;
    example.channel.branchId = "001001001"; example.channel.regionCode = "0002"; example.record.tariff = "SAP00001"; example.record.rate.tariff = "SAP00001";
    example.expectedCode = "";
    example.expected.fee = 6; example.expected.variableAmount = 5; example.expected.range = 2; example.expected.tariff = "SAP00001"; example.expected.applicable = true;
}
