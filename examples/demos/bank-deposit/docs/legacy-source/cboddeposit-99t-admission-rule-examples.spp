domain cboddeposit;
Contract AdmissionRuleExampleFacts {
    DepositRequest request; AccountEligibility account; DepositProduct product; BusinessDay day;
    CashChannel channel; CashAuthorizationPolicy policy; AuthorizationEvidence evidence; AdmissionDecision decision;
    CashAccountControl control; CashFailureFacts failure; String expectedCode;
    InterestPeriod period; InterestProduct interest;
}
atomic calculate initializeAdmissionRuleExample(context AdmissionRuleExampleFacts example) {
    example.request = new DepositRequest(); example.request.amount = 100; example.request.currency = "CNY"; example.request.valueDate = 20261007;
    example.day = new BusinessDay(); example.day.date = 20261007;
    example.account = new AccountEligibility(); example.account.status = "Normal"; example.account.temporary = false;
    example.account.expiresOn = 20261007; example.account.temporaryOpen = false; example.account.detailCount = 10;
    example.account.lastTransactionDate = 20261007; example.account.openedOn = 20261001;
    example.account.cashDepositedToday = 0; example.account.transferredToday = 0; example.account.accountBalance = 0;
    example.product = new DepositProduct(); example.product.minimumOpeningAmount = 100; example.product.maximumOpeningAmount = 5000; example.product.maximumBalance = 10000;
    example.policy = new CashAuthorizationPolicy(); example.policy.warningThreshold = 500; example.policy.tellerLimit = 1000;
    example.policy.levelAMultiplier = 2; example.policy.specialUsdLevelB = 1500; example.policy.specialUsdLevelA = 3000;
    example.channel = new CashChannel(); example.channel.teller = true; example.channel.channel = "Teller";
    example.channel.transactionId = "GSA01102"; example.channel.transactionFamily = "GSA0110"; example.channel.businessCode = "SA0";
    example.evidence = new AuthorizationEvidence(); example.evidence.grantedLevel = "None";
    example.decision = new AdmissionDecision(); example.failure = null; example.expectedCode = "";
    example.control = new CashAccountControl(); example.control.controllingInstitution = ""; example.control.controlStatus = "Normal";
    example.control.cancelledOn = 0; example.control.productKind = "DemandDeposit";
    example.period = new InterestPeriod(); example.period.amount = 199.999; example.period.unit = 100; example.period.days = 3;
    example.interest = new InterestProduct();
}
atomic check verifyAdmissionRuleFailureExample(AdmissionRuleExampleFacts example) {
    require(example.failure != null && example.failure.code == example.expectedCode, "EXAMPLE_ADMISSION_RULE_REJECTION");
}
