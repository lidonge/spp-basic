domain cboddeposit;

atomic calculate configureAdmissionRuleCase19(context AdmissionRuleExampleFacts example) {
    example.request.amount = 400; example.account.cashDepositedToday = 101;
    example.expectedCode = "";
}
atomic check verifyAdmissionRuleCase19(AdmissionRuleExampleFacts example) {
    require(example.decision.warningCode == "F0554", "EXAMPLE_ADMISSION_RULE_19_1");
    require(example.decision.status == "Warning", "EXAMPLE_ADMISSION_RULE_19_2");
    require(example.decision.executable, "EXAMPLE_ADMISSION_RULE_19_3");
}
