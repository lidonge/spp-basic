atomic calculate prepareDepositKernelCase12(context DepositKernelExampleFacts example) {
    example.caseName = "beyond-principal-boundary";
    example.request = new DepositRequest();
    example.account = new DepositAccount();
    example.plan = new DepositPlan();
    example.expected = new DepositPlan();
    example.failure = null;
    example.request.amount = 100.01;
    example.account.interestBase = 0;
    example.account.frozenAmount = 0;
    example.account.authorizedAmount = 0;
    example.account.overdraftInterest = 0;
    example.account.collectionInterest = 0;
    example.account.overdraftPrincipal = 100;
    example.account.overdraftExposure = 120;
    example.account.loanState = "Normal";
    example.snapshot = copy(example.account);
    example.expected.interestPaid = 0;
    example.expected.collectionInterestPaid = 0;
    example.expected.principalPaid = 100;
    example.expected.newInterestBase = .01;
    example.expected.newAvailableBalance = .01;
    example.expected.newOverdraftExposure = 0;
    example.expected.newAccountBalance = .01;
    example.expected.interestBaseIncrease = .01;
    example.expected.interestBaseDecrease = 0;
}
atomic calculate prepareDepositKernelCase13(context DepositKernelExampleFacts example) {
    example.caseName = "frozen-exceeds-funds";
    example.request = new DepositRequest();
    example.account = new DepositAccount();
    example.plan = new DepositPlan();
    example.expected = new DepositPlan();
    example.failure = null;
    example.request.amount = 10;
    example.account.interestBase = 10;
    example.account.frozenAmount = 30;
    example.account.authorizedAmount = 5;
    example.account.overdraftInterest = 3;
    example.account.collectionInterest = 4;
    example.account.overdraftPrincipal = 5;
    example.account.overdraftExposure = 8;
    example.account.loanState = "Normal";
    example.snapshot = copy(example.account);
    example.expected.interestPaid = 0;
    example.expected.collectionInterestPaid = 0;
    example.expected.principalPaid = 0;
    example.expected.newInterestBase = 20;
    example.expected.newAvailableBalance = 0;
    example.expected.newOverdraftExposure = 8;
    example.expected.newAccountBalance = 8;
    example.expected.interestBaseIncrease = 10;
    example.expected.interestBaseDecrease = 0;
}
