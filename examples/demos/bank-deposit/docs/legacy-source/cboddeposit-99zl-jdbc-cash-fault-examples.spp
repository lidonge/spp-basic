domain cboddeposit;

Contract JdbcCashFaultExample {
    CashExample cash; CashTradeReversalLink linkKey; CashTradeReversalLink link;
    CashFailureFacts failure; String prefix; int mode; String expectedCode; String expectedOutcome; String expectedEvent;
}
atomic calculate selectBeforeCommitCashFaultExample(context JdbcCashFaultExample example) {
    example.prefix = "SOURCE-JDBC-BEFORE"; example.mode = 1;
    example.expectedCode = "EXAMPLE_JDBC_BEFORE_COMMIT"; example.expectedOutcome = "ROLLED_BACK"; example.expectedEvent = "RolledBack";
}
atomic calculate selectCommitBeforeCashFaultExample(context JdbcCashFaultExample example) {
    example.prefix = "SOURCE-JDBC-COMMIT-BEFORE"; example.mode = 2;
    example.expectedCode = "Cannot execute quantum transaction"; example.expectedOutcome = "UNKNOWN"; example.expectedEvent = "CommitUnknown";
}
atomic calculate selectCommitAfterCashFaultExample(context JdbcCashFaultExample example) {
    example.prefix = "SOURCE-JDBC-COMMIT-AFTER"; example.mode = 3;
    example.expectedCode = "Cannot execute quantum transaction"; example.expectedOutcome = "UNKNOWN"; example.expectedEvent = "CommitUnknown";
}
atomic calculate selectAfterCommitCashFaultExample(context JdbcCashFaultExample example) {
    example.prefix = "SOURCE-JDBC-RESPONSE"; example.mode = 4;
    example.expectedCode = "EXAMPLE_JDBC_RESPONSE_FAILURE"; example.expectedOutcome = "COMMITTED"; example.expectedEvent = "CommittedResponseFailed";
}
atomic calculate initializeJdbcCashFaultExample(context JdbcCashFaultExample example) {
    example.cash = new CashExample(); example.linkKey = new CashTradeReversalLink(); example.failure = null;
}
atomic calculate configureJdbcCashFaultExample(context JdbcCashFaultExample example) {
    example.cash.seed.id = example.prefix + "-A"; example.cash.seed.eligibility.accountId = example.cash.seed.id;
    example.cash.command.accountId = example.cash.seed.id; example.cash.observed.id = example.cash.seed.id;
    example.cash.command.id = example.prefix + "-T"; example.cash.command.attemptId = example.prefix + "-FIRST";
    example.cash.tradeKey = new CashDepositTrade(); example.cash.tradeKey.id = example.cash.command.id;
    example.cash.postingKey.tradeId = example.cash.command.id; example.cash.auditKey = new CashAuditRecord();
    example.cash.auditKey.attemptId = example.cash.command.attemptId; example.cash.auditKey.tradeId = example.cash.command.id;
    example.linkKey.id = example.cash.command.id;
}
Scenario serial observeJdbcCashFaultExample(context JdbcCashFaultExample example) {
    example.cash.observed = queryCashAccount(example.cash.observed); example.cash.storedTrade = lookupCashDepositTrade(example.cash.tradeKey);
    example.cash.postings = queryCashPostingRecords(example.cash.postingKey); example.link = lookupCashExampleLink(example.linkKey);
    example.cash.history = queryCashExampleHistory(example.cash.auditKey);
}
atomic check verifyInitialJdbcCashFaultExample(JdbcCashFaultExample example) {
    require(example.failure != null && example.failure.code == example.expectedCode, "EXAMPLE_JDBC_CASH_FAILURE_CODE");
    require(example.failure.transactionOutcome == example.expectedOutcome, "EXAMPLE_JDBC_CASH_OUTCOME");
    int lines = 0; double debit = 0; double credit = 0;
    for (CashPostingRecord posting : example.cash.postings) {
        lines++; if (posting.line.side == "Debit") { debit += posting.line.amount; } else { credit += posting.line.amount; }
    }
    int audits = 0; int committed = 0; int failed = 0;
    for (CashAuditRecord audit : example.cash.history) {
        audits++; require(audit.attemptId == example.cash.command.attemptId, "EXAMPLE_JDBC_CASH_ATTEMPT_ID");
        if (audit.event == "Committed") { committed++; }
        if (audit.event == example.expectedEvent) { failed++; require(audit.code == example.expectedCode, "EXAMPLE_JDBC_CASH_AUDIT_CODE"); }
    }
    require(failed == 1, "EXAMPLE_JDBC_CASH_FAILURE_AUDIT");
    if (example.mode <= 2) {
        require(example.cash.observed.version == 0 && example.cash.observed.account.interestBase == 100
            && example.cash.observed.eligibility.accountBalance == 100 && example.cash.observed.eligibility.cashDepositedToday == 0
            && example.cash.storedTrade == null && example.link == null && lines == 0, "EXAMPLE_JDBC_CASH_PARTIAL_COMMIT");
        require(audits == 1 && committed == 0, "EXAMPLE_JDBC_CASH_ROLLBACK_HISTORY");
    } else {
        require(example.cash.observed.version == 1 && example.cash.observed.account.interestBase == 700
            && example.cash.observed.eligibility.accountBalance == 700 && example.cash.observed.eligibility.cashDepositedToday == 600
            && example.cash.storedTrade != null && example.cash.storedTrade.settled.version == 1
            && example.link != null && example.link.version == 0 && example.link.reversalId == ""
            && lines == 8 && debit == 600 && credit == 600, "EXAMPLE_JDBC_CASH_LOST_COMMITTED_DATA");
        require(audits == 2 && committed == 1, "EXAMPLE_JDBC_CASH_COMMITTED_HISTORY");
    }
}
atomic calculate selectJdbcCashFaultRetryExample(context JdbcCashFaultExample example) {
    example.cash.command.attemptId = example.prefix + "-RETRY";
}
atomic calculate selectJdbcCashFaultReplayExample(context JdbcCashFaultExample example) {
    example.cash.command.attemptId = example.prefix + "-REPLAY"; example.cash.command.request.amount = 600.00;
}
atomic check verifyResolvedJdbcCashFaultExample(JdbcCashFaultExample example) {
    require(example.cash.lifecycle.execution.status == "Committed" && example.cash.lifecycle.execution.proposed.version == 1
        && example.cash.observed.version == 1 && example.cash.observed.account.interestBase == 700
        && example.cash.observed.eligibility.accountBalance == 700 && example.cash.observed.eligibility.cashDepositedToday == 600
        && example.cash.observed.eligibility.detailCount == 11, "EXAMPLE_JDBC_CASH_RETRY_DUPLICATE_ACCOUNT");
    require(example.cash.storedTrade != null && example.cash.storedTrade.settled.version == 1
        && example.cash.storedTrade.request.amount == 600 && example.link != null && example.link.version == 0,
        "EXAMPLE_JDBC_CASH_RETRY_ORIGINAL_RESULT");
    int lines = 0; double debit = 0; double credit = 0;
    for (CashPostingRecord posting : example.cash.postings) {
        lines++; if (posting.line.side == "Debit") { debit += posting.line.amount; } else { credit += posting.line.amount; }
    }
    require(lines == 8 && debit == 600 && credit == 600, "EXAMPLE_JDBC_CASH_RETRY_DUPLICATE_LEDGER");
    int count = 0; int failed = 0; int committed = 0; int replayed = 0;
    for (CashAuditRecord audit : example.cash.history) {
        count++; if (audit.event == example.expectedEvent) { failed++; }
        if (audit.event == "Committed") { committed++; } if (audit.event == "Replayed") { replayed++; }
    }
    if (example.mode <= 2) { require(count == 3 && failed == 1 && committed == 1 && replayed == 1, "EXAMPLE_JDBC_CASH_RETRY_HISTORY"); }
    else { require(count == 4 && failed == 1 && committed == 1 && replayed == 2, "EXAMPLE_JDBC_CASH_QUERY_RESOLUTION_HISTORY"); }
}
Scenario serial exerciseJdbcCashFaultExample(context JdbcCashFaultExample example) {
    initializeJdbcCashFaultExample(example); prepareOrdinaryCashExample(example.cash); configureJdbcCashFaultExample(example);
    serial { transaction quantum { seedCashExampleAccount(example.cash.seed); } }
    try { executeCashDeposit(example.cash.command, example.cash.lifecycle); } catch (CashFailureFacts example.failure) {}
    observeJdbcCashFaultExample(example); verifyInitialJdbcCashFaultExample(example);
    selectJdbcCashFaultRetryExample(example); executeCashDeposit(example.cash.command, example.cash.lifecycle);
    selectJdbcCashFaultReplayExample(example); executeCashDeposit(example.cash.command, example.cash.lifecycle);
    observeJdbcCashFaultExample(example); verifyResolvedJdbcCashFaultExample(example);
}
Scenario serial beforeCommitCashFaultExampleRun(context JdbcCashFaultExample example) {
    selectBeforeCommitCashFaultExample(example); exerciseJdbcCashFaultExample(example);
}
Scenario serial commitBeforeCashFaultExampleRun(context JdbcCashFaultExample example) {
    selectCommitBeforeCashFaultExample(example); exerciseJdbcCashFaultExample(example);
}
Scenario serial commitAfterCashFaultExampleRun(context JdbcCashFaultExample example) {
    selectCommitAfterCashFaultExample(example); exerciseJdbcCashFaultExample(example);
}
Scenario serial afterCommitCashFaultExampleRun(context JdbcCashFaultExample example) {
    selectAfterCommitCashFaultExample(example); exerciseJdbcCashFaultExample(example);
}
