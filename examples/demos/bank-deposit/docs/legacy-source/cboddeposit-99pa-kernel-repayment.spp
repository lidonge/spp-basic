    example.account = new DepositAccount();
    example.plan = new DepositPlan();
    example.expected = new DepositPlan();
    example.failure = null;
    example.request.amount = 50;
    example.account.interestBase = 0;
    example.account.frozenAmount = 0;
    example.account.authorizedAmount = 0;
    example.account.overdraftInterest = 30;
    example.account.collectionInterest = 40;
    example.account.overdraftPrincipal = 100;
    example.account.overdraftExposure = 120;
    example.account.loanState = "Normal";
    example.snapshot = copy(example.account);
    example.expected.interestPaid = 30;
    example.expected.collectionInterestPaid = 20;
    example.expected.principalPaid = 0;
    example.expected.newInterestBase = 0;
    example.expected.newAvailableBalance = 0;
    example.expected.newOverdraftExposure = 120;
    example.expected.newAccountBalance = -120;
    example.expected.interestBaseIncrease = 0;
    example.expected.interestBaseDecrease = 0;
}
