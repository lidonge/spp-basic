domain cboddeposit;

atomic calculate prepareDepositKernelCase01(context DepositKernelExampleFacts example) {
    example.caseName = "fractional-interest-business-exact";
    example.request = new DepositRequest();
    example.account = new DepositAccount();
    example.plan = new DepositPlan();
    example.expected = new DepositPlan();
    example.failure = null;
    example.request.amount = .01;
    example.account.interestBase = 0;
    example.account.frozenAmount = 0;
    example.account.authorizedAmount = 0;
    example.account.overdraftInterest = .005;
    example.account.collectionInterest = .004;
    example.account.overdraftPrincipal = .01;
    example.account.overdraftExposure = .02;
    example.account.loanState = "Normal";
    example.snapshot = copy(example.account);
    example.expected.interestPaid = .005;
    example.expected.collectionInterestPaid = .004;
    example.expected.principalPaid = .001;
    example.expected.newInterestBase = 0;
    example.expected.newAvailableBalance = 0;
    example.expected.newOverdraftExposure = .019;
    example.expected.newAccountBalance = -.009;
    example.expected.interestBaseIncrease = 0;
    example.expected.interestBaseDecrease = 0;
}
atomic calculate prepareDepositKernelCase02(context DepositKernelExampleFacts example) {
    example.caseName = "fractional-bad-debt-business-exact";
    example.request = new DepositRequest();
    example.account = new DepositAccount();
    example.plan = new DepositPlan();
    example.expected = new DepositPlan();
    example.failure = null;
    example.request.amount = .01;
    example.account.interestBase = 0;
    example.account.frozenAmount = 0;
    example.account.authorizedAmount = 0;
    example.account.overdraftInterest = .005;
    example.account.collectionInterest = .004;
    example.account.overdraftPrincipal = .01;
    example.account.overdraftExposure = .02;
    example.account.loanState = "BadDebt";
    example.snapshot = copy(example.account);
    example.expected.interestPaid = 0;
    example.expected.collectionInterestPaid = 0;
    example.expected.principalPaid = .01;
    example.expected.newInterestBase = 0;
    example.expected.newAvailableBalance = 0;
    example.expected.newOverdraftExposure = .01;
    example.expected.newAccountBalance = -.009;
    example.expected.interestBaseIncrease = 0;
    example.expected.interestBaseDecrease = 0;
}
atomic calculate prepareDepositKernelCase03(context DepositKernelExampleFacts example) {
    example.caseName = "normal-credit";
    example.request = new DepositRequest();
    example.account = new DepositAccount();
    example.plan = new DepositPlan();
    example.expected = new DepositPlan();
    example.failure = null;
    example.request.amount = 50;
    example.account.interestBase = 100;
    example.account.frozenAmount = 20;
    example.account.authorizedAmount = 10;
    example.account.overdraftInterest = 0;
    example.account.collectionInterest = 0;
    example.account.overdraftPrincipal = 0;
    example.account.overdraftExposure = 0;
    example.account.loanState = "Normal";
    example.snapshot = copy(example.account);
    example.expected.interestPaid = 0;
    example.expected.collectionInterestPaid = 0;
    example.expected.principalPaid = 0;
    example.expected.newInterestBase = 150;
    example.expected.newAvailableBalance = 120;
    example.expected.newOverdraftExposure = 0;
    example.expected.newAccountBalance = 150;
    example.expected.interestBaseIncrease = 50;
    example.expected.interestBaseDecrease = 0;
}
atomic calculate prepareDepositKernelCase04(context DepositKernelExampleFacts example) {
