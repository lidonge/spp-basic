domain cboddeposit;

// Independent expectations from CCMDAT1/CSAPRD2, migrated from BankCalendarTest.
Contract BankCalendarExampleFacts {
    BankDate start;
    BankDate end;
    InterestCalendar calendar;
    InterestPeriod period;
    InterestProduct product;
    CashFailureFacts failure;
    int expectedDays;
    String expectedCode;
    double expectedQualified;
    double expectedProduct;
}
atomic calculate initializeBankCalendarExample(context BankCalendarExampleFacts example) {
    example.start = new BankDate();
    example.end = new BankDate();
    example.calendar = new InterestCalendar();
    example.period = new InterestPeriod();
    example.product = new InterestProduct();
}
atomic check verifyBankCalendarDaysExample(BankCalendarExampleFacts example) {
    require(example.period.days == example.expectedDays, "EXAMPLE_BANK_CALENDAR_DAYS");
}
atomic check verifyBankCalendarFailureExample(BankCalendarExampleFacts example) {
    require(example.failure != null && example.failure.code == example.expectedCode,
        "EXAMPLE_BANK_CALENDAR_FAILURE");
}
atomic check verifyBankCalendarInterestExample(BankCalendarExampleFacts example) {
    require(example.product.qualifiedAmount == example.expectedQualified
        && example.product.product == example.expectedProduct, "EXAMPLE_BANK_INTEREST_UNITS");
}

atomic calculate prepareBankCalendarCase01(context BankCalendarExampleFacts example) {
    example.start.encoded = 20240228;
    example.end.encoded = 20240301;
    example.calendar.convention = "ACT";
    example.expectedDays = 2;
    example.expectedCode = "";
    example.failure = null;
}

