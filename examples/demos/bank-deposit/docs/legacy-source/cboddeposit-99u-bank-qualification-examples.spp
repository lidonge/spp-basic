domain cboddeposit;
Contract BankQualificationExampleFacts { DepositBankProfile profile; DepositOperatorFacts operator; CashChannel channel; DepositNotices notices; CashFailureFacts failure; String expectedCode; }
atomic calculate initializeBankQualificationExample(context BankQualificationExampleFacts example) {
    example.profile = new DepositBankProfile(); example.operator = new DepositOperatorFacts();
    example.channel = new CashChannel(); example.channel.teller = true; example.channel.channel = "Teller";
    example.channel.transactionId = "GSA01102"; example.channel.transactionFamily = "GSA0110"; example.channel.businessCode = "SA0";
    example.notices = new DepositNotices(); example.failure = null; example.expectedCode = "";
    example.profile.normalSavings = true;
    example.profile.restrictedSubtype = false;
    example.profile.openingBranch = "001001001";
    example.profile.openingProvince = "001";
    example.profile.subbranch = "SB001";
    example.profile.area = "0001";
    example.profile.areaProvince = "00";
    example.profile.depositRange = "City";
    example.profile.proprietaryRange = "Open";
    example.profile.cardLinked = false;
    example.profile.accountSeries = "General";
    example.profile.cardRecordFound = false;
    example.profile.cardLoss = "None";
    example.profile.cardStatus = "Normal";
    example.profile.passbookLoss = "None";
    example.profile.groupSubaccount = false;
    example.operator.branch = "001001002";
    example.operator.province = "001";
    example.operator.subbranch = "SB001";
    example.operator.area = "0001";
    example.operator.areaProvince = "00";
    example.operator.accountingCentre = false;
    example.operator.transactionPrefix = "SA01102";
    example.operator.operationCode = "1102";
    example.operator.tellerFamily = "Ordinary";
    example.operator.tellerNumber = 0;
    example.operator.numericTeller = true;
    example.operator.mode = "Online";
    example.operator.agencySigned = false;
    example.operator.corporateTransfer = false;
    example.operator.settlementChannel = "Teller";
}
atomic check verifyBankQualificationFailureExample(BankQualificationExampleFacts example) {
    require(example.failure != null && example.failure.code == example.expectedCode, "EXAMPLE_BANK_QUALIFICATION_REJECTION");
}
Scenario serial bankQualificationRulesExampleRun(context BankQualificationExampleFacts example) {
