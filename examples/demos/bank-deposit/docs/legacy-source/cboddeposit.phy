domain cboddeposit;
phy {
    numeric double as BigDecimal;
    repository cashRecords {
        adapter jdbcObjectRepository;
        config default = true;
        config appDdlTables = true;
        config datasourceUrl = "${spp.xbod.datasource-url:jdbc:h2:mem:xbod-deposit;DB_CLOSE_DELAY=-1}";
        config driverClassName = "org.h2.Driver";
        config table = "xbod_cash_record";
    }
    backend cashDatabase {
        adapter localJdbc;
        quantum cashBusinessRecords;
        quantum cashSettlement;
        saga cashSagaDepositNode;
        saga cashSagaLaterNode;
        saga cashSagaWorkflow;
        repository cashRecords;
        quantumStore cashLedger;
        config datasourceUrl = "${spp.xbod.datasource-url:jdbc:h2:mem:xbod-deposit;DB_CLOSE_DELAY=-1}";
        config driverClassName = "org.h2.Driver";
    }
    quantumStore cashLedger {
        adapter jdbcQuantum;
        config datasourceUrl = "${spp.xbod.datasource-url:jdbc:h2:mem:xbod-deposit;DB_CLOSE_DELAY=-1}";
        config driverClassName = "org.h2.Driver";
        config journalStore = "com.servpp.service.transaction.JdbcQuantumJournalStore";
        config journalTable = "xbod_quantum_journal";
        config valueTable = "xbod_quantum_value";
        config decimalStorage = "text";
    }
}
