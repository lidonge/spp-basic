domain cboddeposit;
header requestContext { unique String globalSerialNumber; }
header responseContext { String status(Default = "OK"); }
// Identity-only table declarations make each account's quantum values independent.
tables roles {
    table CASH_ELIGIBILITY_ID(AccountEligibility) { primarykey notnull String accountId; }
    table CASH_CLEARING_ID(CashQuantumClearing) { primarykey notnull String accountId; }
}
// Numeric evidence roles map explicitly to the physical text schema.
tables roles {
    table xbod_quantum_journal(QuantumJournalEvidence) {
        primarykey(QuantumJournalEvidence.transactionId, QuantumJournalEvidence.sequenceNo);
    }
    table xbod_quantum_value(QuantumValueEvidence) {
        primarykey(QuantumValueEvidence.attributeId, QuantumValueEvidence.objectId);
    }
}
map xbod_quantum_journal {
    transactionId = notnull String(128) transaction_id;
    sequenceNo = notnull int sequence_no;
    boundaryServiceId = notnull String(512) boundary_service_id;
    status = notnull String(32) status;
    groupId = notnull String(256) group_id;
    attributeId = notnull String(512) attribute_id;
    objectId = notnull String(512) object_id;
    beforeValue = notnull String(4096) before_value;
    deltaValue = notnull String(4096) delta_value;
    afterValue = notnull String(4096) after_value;
}
map xbod_quantum_value {
    attributeId = notnull String(512) attribute_id;
    objectId = notnull String(512) object_id;
    groupId = notnull String(256) group_id;
    boundaryServiceId = notnull String(512) boundary_service_id;
    transactionId = notnull String(128) transaction_id;
    currentValue = notnull String(4096) current_value;
}
quantumStore cashLedger {
    attribute DepositRequest.amount;
    attribute DepositAccount.interestBase;
    attribute DepositAccount.frozenAmount;
    attribute DepositAccount.authorizedAmount;
    attribute DepositAccount.overdraftInterest;
    attribute DepositAccount.collectionInterest;
    attribute DepositAccount.overdraftPrincipal;
    attribute DepositAccount.overdraftExposure;
    attribute AccountEligibility.cashDepositedToday;
    attribute AccountEligibility.transferredToday;
    attribute AccountEligibility.accountBalance;
    attribute DepositPostingLine.amount;
    attribute CashQuantumClearing.amount;
}

