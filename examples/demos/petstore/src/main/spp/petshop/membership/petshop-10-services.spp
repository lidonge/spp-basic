domain petshop;

atomic check checkCustomerProfile(Buyer) {
    require(Buyer.name != null && Buyer.name != "", "NAME_REQUIRED");
    require(Buyer.email != null && Buyer.email != "", "EMAIL_REQUIRED");
    require(Buyer.address != null && Buyer.address != "", "ADDRESS_REQUIRED");
    require(Buyer.tier == MemberTier.NORMAL || Buyer.tier == MemberTier.VIP, "INVALID_MEMBER_TIER");
}

atomic calculate registerCustomer(Buyer, Cart) {
    Buyer.wallet = 0;
    Cart.buyer = Buyer;
    Cart.lines = new CartLine[] {
    };
}

atomic calculate updateProfile(ProfileAgreement, Buyer) {
    Buyer.name = ProfileAgreement.newName;
    Buyer.email = ProfileAgreement.newEmail;
    Buyer.address = ProfileAgreement.newAddress;
    Buyer.tier = ProfileAgreement.newTier;
}

atomic check checkNewCustomer(Buyer) {
    require(!Buyer, "CUSTOMER_EXISTS");
}

atomic check checkBuyerCredential(Buyer) {
    require(Buyer.membershipNumber != null && Buyer.membershipNumber != "", "MEMBERSHIP_NUMBER_REQUIRED");
}

atomic calculate locateBuyerCart(Buyer, Cart) {
    Cart.buyer = Buyer;
}
