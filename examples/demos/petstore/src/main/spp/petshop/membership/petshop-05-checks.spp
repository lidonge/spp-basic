domain petshop;

atomic check checkProfileAgreementInput(ProfileAgreement) {
    require(profileAgreement.newName != BLANK, RejectionCode.NAME_REQUIRED);
    require(profileAgreement.newEmail != BLANK, RejectionCode.EMAIL_REQUIRED);
    require(profileAgreement.newAddress != BLANK, RejectionCode.ADDRESS_REQUIRED);
    require(
        profileAgreement.newTier == MemberTier.NORMAL || profileAgreement.newTier == MemberTier.VIP,
        RejectionCode.INVALID_MEMBER_TIER
    );
}
