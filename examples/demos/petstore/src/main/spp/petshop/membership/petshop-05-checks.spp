domain petshop;

atomic check checkProfileAgreementInput(ProfileAgreement) {
    require(ProfileAgreement.newName != BLANK, "NAME_REQUIRED");
    require(ProfileAgreement.newEmail != BLANK, "EMAIL_REQUIRED");
    require(ProfileAgreement.newAddress != BLANK, "ADDRESS_REQUIRED");
    require(
        ProfileAgreement.newTier == MemberTier.NORMAL || ProfileAgreement.newTier == MemberTier.VIP,
        "INVALID_MEMBER_TIER"
    );
}
