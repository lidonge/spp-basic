domain petshop;

atomic calculate initializeCatalog(
    Goods[],
    StockLine[],
    StockSupply[],
    Merchant,
    SettlementAccount,
    StoreOpeningAgreement
) {
    for (Goods product : goodss) {
        product.active = true;
        switch (product.sku) {
            case "CAT-001":
                product.price = 1200;
                break;
            case "FOOD-001":
                product.price = 29.90;
                break;
            case "TOY-001":
                product.price = 12.35;
                break;
            case "DOG-001":
                product.price = 1800;
                break;
        }
    }
    initializeInventory;
    merchant.tradingName = storeOpeningAgreement.tradingName;
    merchant.shopName = storeOpeningAgreement.shopName;

    settlementAccount.accountNumber = "EXTERNAL-SETTLEMENT";

}

Scenario serial initializeStore(
    Goods,
    Goods[],
    StockLine[],
    StockSupply[],
    Merchant,
    SettlementAccount,
    StoreOpeningAgreement
) {
    configureStoreOpening;
    configureMerchantLookup;
    findMerchant;
    if (!merchant) {
        findPerson(merchant);
        identify(merchant);
        prepareProductSelection;
        importCatalogue;
        initializeCatalog;
        transaction {
            insertGoods(goodss);
            insertStockLine;
            insertStockSupply;
            insertMerchant;
            insertSettlementAccount;
        }
    }
}

atomic calculate configureStoreOpening(StoreOpeningAgreement) {
    if (storeOpeningAgreement.tradingName == BLANK) {
        storeOpeningAgreement.tradingName = MERCHANT_NAME;
    }
    if (storeOpeningAgreement.shopName == BLANK) {
        storeOpeningAgreement.shopName = SHOP_NAME;
    }
}

atomic calculate configureMerchantLookup(Merchant) {
    merchant.customerNumber = "MERCHANT-001";
}
