domain petshop;

Role Merchant {
    String tradingName;
    String shopName;
    quantum BigDecimal(19, 2) cash;
    business("Customer-domain subject registration number") String customerNumber;
    String name;
    String email;
    String address;
}

Entity Receipt {
    business("Business receipt number") String receiptNumber;
    Buyer buyer;
    ShopOrder order;
    ReceiptStatus status;
    OrderStatus orderStatus;
}
