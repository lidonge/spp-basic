domain petshop;

Enum RejectionCode {
    ADDRESS_REQUIRED,
    CART_NOT_FOUND,
    CUSTOMER_EXISTS,
    EMAIL_REQUIRED,
    EMPTY_CART,
    INSUFFICIENT_FUNDS,
    INSUFFICIENT_STOCK,
    INVALID_FUNDING_AMOUNT,
    INVALID_GOODS_PRICE,
    INVALID_MEMBER_TIER,
    INVALID_QUANTITY,
    INVENTORY_ITEM_NOT_FOUND,
    ITEM_REQUIRED,
    MEMBERSHIP_NUMBER_REQUIRED,
    NAME_REQUIRED,
    ORDER_NOT_CANCELLABLE,
    ORDER_NOT_DELIVERABLE,
    ORDER_NOT_FOUND,
    ORDER_NOT_PAYABLE,
    ORDER_NOT_RETURNABLE,
    ORDER_NOT_SHIPPABLE,
    PRODUCT_UNAVAILABLE,
    REASON_REQUIRED,
    RESERVATION_MISSING,
    RETURN_NOT_REQUESTED,
    SOLD_STOCK_MISSING,
    TRACKING_REQUIRED
}

Enum OrderStatus {
    UNPAID:"UNPAID",
    PAID:"PAID",
    SHIPPED:"SHIPPED",
    DELIVERED:"DELIVERED",
    CANCELLED:"CANCELLED",
    RETURN_REQUESTED:"RETURN_REQUESTED",
    RETURNED:"RETURNED"
}

Enum ReceiptStatus {
    COMPLETED:"COMPLETED"
}

Enum MemberTier {
    NORMAL:"NORMAL",
    VIP:"VIP"
}

Enum ReservationStatus {
    ACCEPTED:"ACCEPTED",
    RESERVED:"RESERVED",
    REJECTED:"REJECTED"
}

Enum ReservationRejectionReason {
    INSUFFICIENT_STOCK:"INSUFFICIENT_STOCK",
    RESERVATION_NOT_COMPLETED:"RESERVATION_NOT_COMPLETED"
}
