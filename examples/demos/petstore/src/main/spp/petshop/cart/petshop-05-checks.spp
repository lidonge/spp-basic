domain petshop;

atomic check checkCartAdditionAgreementInput(CartAdditionAgreement) {
    require(cartAdditionAgreement.quantity != null && cartAdditionAgreement.quantity > 0, RejectionCode.INVALID_QUANTITY);
}

atomic check checkCartQuantityAgreementInput(CartQuantityAgreement) {
    require(cartQuantityAgreement.quantity != null && cartQuantityAgreement.quantity > 0, RejectionCode.INVALID_QUANTITY);
}
