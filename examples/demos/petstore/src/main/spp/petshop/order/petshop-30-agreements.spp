domain petshop;

atomic calculate initializeUnpaidCancellationAgreement(Buyer, ShopOrder, UnpaidCancellationAgreement) {
    UnpaidCancellationAgreement.buyer = Buyer;
    UnpaidCancellationAgreement.order = ShopOrder;

    UnpaidCancellationAgreement.releasedQuantity = 0;
}

atomic calculate initializePaidCancellationAgreement(Buyer, Merchant, ShopOrder, PaidCancellationAgreement) {
    PaidCancellationAgreement.buyer = Buyer;
    PaidCancellationAgreement.order = ShopOrder;
    PaidCancellationAgreement.seller = Merchant;

    PaidCancellationAgreement.releasedQuantity = 0;
    PaidCancellationAgreement.refundAmount = 0;
}

atomic calculate prepareUnpaidCancellationAgreementReceipt(ShopOrder, UnpaidCancellationAgreement) {
    UnpaidCancellationAgreement.order = ShopOrder;
    UnpaidCancellationAgreement.receipt = new Receipt();
    UnpaidCancellationAgreement.receipt.order = ShopOrder;
    UnpaidCancellationAgreement.receipt.buyer = ShopOrder.buyer;
    UnpaidCancellationAgreement.receipt.status = ReceiptStatus.COMPLETED;
    UnpaidCancellationAgreement.receipt.orderStatus = ShopOrder.status;
}

atomic calculate preparePaidCancellationAgreementReceipt(ShopOrder, PaidCancellationAgreement) {
    PaidCancellationAgreement.order = ShopOrder;
    PaidCancellationAgreement.receipt = new Receipt();
    PaidCancellationAgreement.receipt.order = ShopOrder;
    PaidCancellationAgreement.receipt.buyer = ShopOrder.buyer;
    PaidCancellationAgreement.receipt.status = ReceiptStatus.COMPLETED;
    PaidCancellationAgreement.receipt.orderStatus = ShopOrder.status;
}

atomic calculate preparePurchaseReceipt(ShopOrder, Receipt) {
    Receipt.buyer = ShopOrder.buyer;
    Receipt.order = ShopOrder;
    Receipt.status = ReceiptStatus.COMPLETED;
    Receipt.orderStatus = ShopOrder.status;
}
