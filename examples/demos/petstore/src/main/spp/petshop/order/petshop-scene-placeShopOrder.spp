domain petshop;

Scenario serial placeShopOrder(Buyer, Cart, StockLine[], ShopOrder, Goods, Goods[], Receipt, CartLine[]) {
    checkBuyerCredential;
    prepareProductSelection;
    parallel {
        findBuyer;
        listProducts;
    }
    identify(buyer);
    locateBuyerCart;
    findCart;
    identify(cart);
    checkCart;
    checkQuotationInput;
    quoteOrder;
    prepareOrderInventory;
    findStockLine;
    identify(stockLines);
    checkOrderReservation;
    captureCartLines;
    reserveOrder;
    transaction {
        deleteCartLine;
        insertOrderLine(shopOrder.lines);
        insertShopOrder;
        reserveInventory bounds {
            stockLines.available: [0, null];
            stockLines.reserved: [0, null];
        };
        updateCart;

        preparePurchaseReceipt;
        insertReceipt;
    }
}
