domain petshop;

Scenario serial previewShopOrder(Buyer, Cart, ShopOrder, Goods, Goods[]) {
    checkBuyerCredential;
    prepareProductSelection;
    findBuyer;
    identify(Buyer);
    locateBuyerCart;
    findCart;
    identify(Cart);
    checkCart;
    listProducts;
    checkQuotationInput;
    quoteOrder;
}
