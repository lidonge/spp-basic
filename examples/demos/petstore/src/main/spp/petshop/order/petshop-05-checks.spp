domain petshop;

atomic check checkQuotationInput(Cart, Goods[]) {
    require(Cart.lines != null, RejectionCode.EMPTY_CART);
    int count = 0;
    for (CartLine line : Cart.lines) {
        require(line != null && line.quantity != null && line.quantity > 0, RejectionCode.INVALID_QUANTITY);
        boolean found = false;
        for (Goods product : Goods[]) {
            if (product.sku == line.goods.sku) {
                found = true;
            }
        }
        require(found, RejectionCode.PRODUCT_UNAVAILABLE);
        count++;
    }
    require(count > 0, RejectionCode.EMPTY_CART);
}

atomic check checkUnpaidCancellationAgreementInput(UnpaidCancellationAgreement) {
    require(
        UnpaidCancellationAgreement.reason != BLANK,
        RejectionCode.REASON_REQUIRED
    );
}

atomic check checkUnpaidCancellation(ShopOrder) {
    require(ShopOrder.status == OrderStatus.UNPAID, RejectionCode.ORDER_NOT_CANCELLABLE);
}

atomic check checkPaidCancellationAgreementInput(PaidCancellationAgreement) {
    require(
        PaidCancellationAgreement.reason != BLANK,
        RejectionCode.REASON_REQUIRED
    );
}

atomic check checkPaidCancellation(ShopOrder) {
    require(ShopOrder.status == OrderStatus.PAID, RejectionCode.ORDER_NOT_CANCELLABLE);
}

atomic check checkOrderReservation(ShopOrder, StockLine[]) {
    for (OrderLine line : ShopOrder.lines) {
        boolean found = false;
        for (StockLine stock : StockLine[]) {
            if (stock.goods.sku == line.goods.sku) {
                int needed = 0;
                for (OrderLine ordered : ShopOrder.lines) {
                    if (ordered.goods.sku == line.goods.sku) {
                        needed += ordered.quantity;
                    }
                }
                require(stock.available >= needed, RejectionCode.INSUFFICIENT_STOCK);
                found = true;
            }
        }
        require(found, RejectionCode.INVENTORY_ITEM_NOT_FOUND);
    }
}
