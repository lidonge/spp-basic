domain petshop;

atomic check checkShipmentAgreementInput(ShipmentAgreement) {
    require(shipmentAgreement.tracking != BLANK, RejectionCode.TRACKING_REQUIRED);
}

atomic check checkShipmentEligibility(ShopOrder) {
    require(shopOrder.status == OrderStatus.PAID, RejectionCode.ORDER_NOT_SHIPPABLE);
}

atomic check checkDeliveryEligibility(ShopOrder) {
    require(shopOrder.status == OrderStatus.SHIPPED, RejectionCode.ORDER_NOT_DELIVERABLE);
}

atomic check checkReservedInventory(ShopOrder, StockLine[]) {
    for (OrderLine line : shopOrder.lines) {
        boolean found = false;
        for (StockLine stock : stockLines) {
            if (stock.goods.sku == line.goods.sku) {
                int needed = 0;
                for (OrderLine ordered : shopOrder.lines) {
                    if (ordered.goods.sku == line.goods.sku) {
                        needed += ordered.quantity;
                    }
                }
                require(stock.reserved >= needed, RejectionCode.RESERVATION_MISSING);
                found = true;
            }
        }
        require(found, RejectionCode.INVENTORY_ITEM_NOT_FOUND);
    }
}
