domain petshop;

atomic calculate initializeReturnRequestAgreement(Buyer, ShopOrder, ReturnRequestAgreement) {
    ReturnRequestAgreement.Buyer = Buyer;
    ReturnRequestAgreement.ShopOrder = ShopOrder;
}

atomic calculate prepareReturnRequestReceipt(ShopOrder, ReturnRequestAgreement) {
    ReturnRequestAgreement.Receipt = new Receipt();
    ReturnRequestAgreement.Receipt.order = ShopOrder;
    ReturnRequestAgreement.Receipt.buyer = ShopOrder.buyer;
    ReturnRequestAgreement.Receipt.status = ReceiptStatus.COMPLETED;
    ReturnRequestAgreement.Receipt.orderStatus = ShopOrder.status;
}

atomic calculate initializeReturnRefundAgreement(Buyer, Merchant, ShopOrder, ReturnRefundAgreement) {
    ReturnRefundAgreement.buyer = Buyer;
    ReturnRefundAgreement.order = ShopOrder;
    ReturnRefundAgreement.seller = Merchant;

    ReturnRefundAgreement.returnedQuantity = 0;
    ReturnRefundAgreement.refundAmount = 0;
}

atomic calculate prepareReturnRefundAgreementReceipt(ShopOrder, ReturnRefundAgreement) {
    ReturnRefundAgreement.order = ShopOrder;
    ReturnRefundAgreement.receipt = new Receipt();
    ReturnRefundAgreement.receipt.order = ShopOrder;
    ReturnRefundAgreement.receipt.buyer = ShopOrder.buyer;
    ReturnRefundAgreement.receipt.status = ReceiptStatus.COMPLETED;
    ReturnRefundAgreement.receipt.orderStatus = ShopOrder.status;
}
