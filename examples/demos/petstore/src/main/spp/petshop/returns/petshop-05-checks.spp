domain petshop;

atomic check checkReturnRequest(ShopOrder) {
    require(shopOrder.status == OrderStatus.DELIVERED, RejectionCode.ORDER_NOT_RETURNABLE);
}

atomic check checkReturnApproval(ShopOrder) {
    require(shopOrder.status == OrderStatus.RETURN_REQUESTED, RejectionCode.RETURN_NOT_REQUESTED);
}

atomic check checkSoldInventory(ShopOrder, StockLine[]) {
    for (OrderLine line : shopOrder.lines) {
        boolean found = false;
        for (StockLine stock : stockLines) {
            if (stock.goods.sku == line.goods.sku) {
                int needed = 0;
                for (OrderLine ordered : shopOrder.lines) {
                    if (ordered.goods.sku == line.goods.sku) {
                        needed += ordered.quantity;
                    }
                }
                require(stock.sold >= needed, RejectionCode.SOLD_STOCK_MISSING);
                found = true;
            }
        }
        require(found, RejectionCode.INVENTORY_ITEM_NOT_FOUND);
    }
}

atomic check checkReturnRequestAgreementInput(ReturnRequestAgreement) {
    require(returnRequestAgreement.reason != BLANK, RejectionCode.REASON_REQUIRED);
}
